{
  "name": "content-publisher",
  "version": "1.0.0",
  "description": "Publish Markdown articles to multiple Chinese content platforms (WeChat, Zhihu, Weibo, CSDN, Juejin, etc.) from a single source.",
  "main": "src/index.js",
  "bin": {
    "content-publisher": "bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "node --watch bin/cli.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/",
    "docs": "node bin/cli.js docs"
  },
  "keywords": [
    "markdown",
    "publisher",
    "cli",
    "wechat",
    "weixin",
    "zhihu",
    "weibo",
    "csdn",
    "juejin",
    "blogging"
  ],
  "author": "your-username",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/content-publisher.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/content-publisher/issues"
  },
  "homepage": "https://github.com/your-username/content-publisher#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.1.0",
    "ora": "^5.4.1",
    "playwright": "^1.40.0",
    "sharp": "^0.33.0"
  }
}
